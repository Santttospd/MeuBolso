# Modelo dos Secrets. Copie para .streamlit/secrets.toml (local) ou cole
# em Settings > Secrets no painel da Streamlit Community Cloud.

[connections.banco]
# Local: "sqlite:///meu_bolso.db"
# Produção: URL do PostgreSQL (Neon, Supabase...), por exemplo:
url = "postgresql+psycopg2://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

[cookie]
name = "meu_bolso_login"
key = "troque-por-um-texto-aleatorio-longo"   # python -c "import secrets; print(secrets.token_urlsafe(32))"
expiry_days = 7

# Opcional: os usuários se cadastram pela tela "Criar conta" e ficam no banco.
# Usuários listados aqui são copiados para o banco na primeira execução.
# A senha é o hash gerado por: python gerar_senha.py
[credentials.usernames.pedro]
email = "seu-email@exemplo.com"
first_name = "Pedro"
last_name = "Silva"
password = "$2b$12$..."
